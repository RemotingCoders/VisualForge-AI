# Copy to .env.local (note the leading dot — Next.js only loads ".env.local", not "env.local")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Model API (SERVER ONLY) — verified 2026-10-28 from dev.meta.ai/docs/models ---
MODEL_API_KEY=
# Base: https://api.meta.ai/v1 · Auth: Authorization: Bearer $MODEL_API_KEY
# Models: muse-image-1.0 · sam-3.1 · muse-spark-1.3
META_REAL_CALLS_ENABLED=false
AI_PROVIDER=mock

MAX_CHANGES_PER_JOB=10
MAX_JOBS_PER_DAY=20
ESTIMATED_COST_PER_LEVEL_USD=1.50

# VF_ACCESS_CODE: public-demo credit protection — ONE access rule for every
# route that calls Meta's models. When set, POST /api/generate (level
# generation, theme scene generation, dictation theme moderation) AND
# POST /api/ai-inspect ("Race against Spark" / "Challenge the AI inspector")
# require this code; without a valid code they answer 401: "This action uses
# Meta's models and needs the judge access code from the hackathon submission.
# The gallery is free to play." Routes that never call Meta stay open:
# gallery, stored levels, clicks, saved hints, exports. The code ships in the
# hackathon submission form, never in code; the Play/QC pages ask judges for
# it once and remember it in localStorage. Unset = no code required (local
# development). When it is set, a per-IP limit of 5 generations/hour also
# applies; the daily cap above always applies and is counted from today's
# visualforge_generation_jobs rows.
VF_ACCESS_CODE=

# VF_SPEND_CAP_USD + VF_SPEND_CAP_SINCE: hard global budget for the judging
# period (second layer, for when the hackathon credits expire and usage would
# bill the owner's card). Before any paid call, the Meta-calling routes sum
# estimated_cost_usd in visualforge_ai_calls since VF_SPEND_CAP_SINCE (ISO
# date, e.g. 2026-11-04); at or over the cap they answer 429: "Budget for the
# judging period is exhausted; the gallery remains playable". Costs are the
# real published prices (Spark per token, SAM per image, Muse Image per
# image — src/lib/engine/pricing.ts), and every generation job logs its own
# estimated spend, the accumulated total and the remaining budget. Unset
# cap = no budget limit (local development).
VF_SPEND_CAP_USD=
VF_SPEND_CAP_SINCE=

# VF_PUBLIC_HOST: canonical public host of the live demo (no scheme, no port),
# e.g. visualforge-ai.taplinko.store. When set, the Next middleware answers any
# request that still arrives under the legacy visualforge-ai.onrender.com host
# with a 301 redirect to the same path on this host. Unset = no redirects
# (local development).
VF_PUBLIC_HOST=

# --- Optional Meta capability flags (each defaults OFF) ---
# VF_SAM_MASKS: use real SAM masks (official @meta-sam/parser) for local recolor and
# crop composition, falling back to bbox behavior per change when a mask is unusable.
VF_SAM_MASKS=false
# VF_THEME_GENERATION: Play can generate the scene itself from a text theme
# (Spark text moderation first, then one Muse Image generation, $0.01 flat).
VF_THEME_GENERATION=false
# Reasoning effort for the scene-generation call only (docs enum; default high).
VF_SCENE_REASONING=high
